<Project>
  <!--
    Phosphor's version, for every project. PhosphorVersion is the release being worked toward:
    bump it when work on the next one starts. A build of the commit tagged v$(PhosphorVersion) is that
    release ("0.1.0+a1b2c3d"); any other build is a dev build, numbered by the repository's commit
    count, which only grows ("0.1.0-dev.812+a1b2c3d"). Shown in About, answered to XTVERSION, in the
    exe's file properties and the crash log; scripts/install.ps1 names install folders after it.
  -->
  <PropertyGroup>
    <PhosphorVersion>0.1.0</PhosphorVersion>
    <Version>$(PhosphorVersion)</Version>
    <!-- The SDK's own "+<full commit>" suffix is replaced by ours. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <Target Name="PhosphorGitVersion" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo" Condition="'$(PhosphorInformationalVersion)' == ''">
    <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low"
          StandardErrorImportance="low" WorkingDirectory="$(MSBuildThisFileDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_PhosphorCommits" />
    </Exec>
    <Exec Command="git rev-parse --short=7 HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low"
          StandardErrorImportance="low" WorkingDirectory="$(MSBuildThisFileDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_PhosphorHash" />
    </Exec>
    <Exec Command="git describe --exact-match --tags --match v$(PhosphorVersion) HEAD" IgnoreExitCode="true" StandardOutputImportance="low"
          StandardErrorImportance="low" EchoOff="true" WorkingDirectory="$(MSBuildThisFileDirectory)">
      <Output TaskParameter="ExitCode" PropertyName="_PhosphorTagged" />
    </Exec>
    <PropertyGroup>
      <_PhosphorDev Condition="'$(_PhosphorTagged)' != '0' and '$(_PhosphorCommits)' != ''">-dev.$(_PhosphorCommits)</_PhosphorDev>
      <_PhosphorBuild Condition="'$(_PhosphorHash)' != ''">+$(_PhosphorHash)</_PhosphorBuild>
      <PhosphorInformationalVersion>$(PhosphorVersion)$(_PhosphorDev)$(_PhosphorBuild)</PhosphorInformationalVersion>
      <InformationalVersion>$(PhosphorInformationalVersion)</InformationalVersion>
      <FileVersion Condition="'$(_PhosphorCommits)' != ''">$(PhosphorVersion).$(_PhosphorCommits)</FileVersion>
    </PropertyGroup>
  </Target>
</Project>
