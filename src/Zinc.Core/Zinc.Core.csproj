<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Zinc.Platform.props" />
  <!-- Everything that doesn't need WinUI: libghostty bindings, ConPTY, the terminal
       session, input mapping and config. Testable without a window. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Zinc</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ZincWindows)' != 'true'">
    <TargetFramework>net10.0</TargetFramework>
    <TargetPlatformMinVersion />
  </PropertyGroup>

  <!-- Each platform compiles its own PTY (Pty/IPty.cs). -->
  <ItemGroup>
    <Compile Remove="Pty\PosixPty.cs" Condition="'$(ZincWindows)' == 'true'" />
    <Compile Remove="Posix\**" Condition="'$(ZincWindows)' == 'true'" />
    <Compile Remove="Pty\ConPty.cs" Condition="'$(ZincWindows)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zinc.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>
</Project>
