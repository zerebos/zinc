<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Phosphor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Phosphor">
    <Grid x:Name="Root" RequestedTheme="Dark">
        <!-- The tab strip doubles as the title bar (ExtendsContentIntoTitleBar).
             TabView's style defaults to VerticalAlignment=Top: without Stretch the control
             is only as tall as its strip and tab content gets 0 px. -->
        <TabView
            x:Name="Tabs"
            VerticalAlignment="Stretch"
            TabWidthMode="Equal"
            CanReorderTabs="True"
            CanDragTabs="False"
            AllowDropTabs="False"
            AddTabButtonClick="OnAddTabButtonClick"
            TabCloseRequested="OnTabCloseRequested"
            SelectionChanged="OnSelectionChanged">
            <TabView.TabStripFooter>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Sized and placed like TabView's own "+" button (24 px tall,
                         3 px above the strip's bottom) so the two line up. -->
                    <Button
                        x:Name="NewTabMenuButton"
                        Height="24"
                        Margin="0,0,0,3"
                        VerticalAlignment="Bottom"
                        Padding="8,0"
                        Background="Transparent"
                        BorderThickness="0"
                        AutomationProperties.Name="Open a profile"
                        ToolTipService.ToolTip="Open a profile (Ctrl+Shift+Space)">
                        <FontIcon FontSize="12" Glyph="&#xE70D;" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="NewTabMenu" Placement="BottomEdgeAlignedLeft" />
                        </Button.Flyout>
                    </Button>
                    <!-- Empty strip area: drags the window. -->
                    <Grid x:Name="DragRegion" Grid.Column="1" Background="Transparent" />
                </Grid>
            </TabView.TabStripFooter>
        </TabView>

        <!-- Shown when the quick terminal's global hotkey is held by another app. -->
        <InfoBar
            x:Name="HotkeyNotice"
            MaxWidth="520"
            Margin="12"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsOpen="False"
            Severity="Warning"
            Title="Quick terminal hotkey unavailable" />

        <!-- Command palette (Ctrl+Shift+P). The transparent layer catches clicks outside
             the panel to close it. -->
        <Grid x:Name="PaletteLayer" Background="Transparent" Visibility="Collapsed">
            <Border
                x:Name="PalettePanel"
                Width="640"
                MaxHeight="460"
                Margin="0,52,0,0"
                Padding="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox
                        x:Name="PaletteQuery"
                        AutomationProperties.Name="Command palette search"
                        PlaceholderText="Type a command (tabs, panes, profiles…)" />
                    <ListView
                        x:Name="PaletteList"
                        Grid.Row="1"
                        AutomationProperties.Name="Commands"
                        IsItemClickEnabled="True"
                        SelectionMode="Single" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
