<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Zinc</RootNamespace>
    <AssemblyName>zinc</AssemblyName>
    <Product>Zinc</Product>
    <AssemblyTitle>Zinc</AssemblyTitle>
    <Company>Zinc</Company>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <!-- Also covers solution builds, which may pass Platform=AnyCPU globally (a global
         property the Platform default above can't override); WinAppSDK then keys off the RID. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Needed so `dotnet publish` includes the .pri and compiled XAML (.xbf) of an
         unpackaged app; without them WinUI crashes at startup (0xC000027B). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embedded in the exe: Explorer, Start Menu shortcut, Raycast. The brand's icon (docs/brand.md), hand-placed frames. -->
    <ApplicationIcon>Assets\Zinc.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.cs is the entry point: it redirects second launches to the running instance. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Publishes drop the unused code of libraries marked trimmable (.NET, the Windows SDK projection: 25 MB -> 0.3);
         ours, Tomlyn and Velopack stay whole. 200 -> 112 MB installed, 76 -> 44 MB download (2026-10-03 size audit). -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- Trimming turns built-in COM off; TaskbarProgress, FolderDialog, TerminalHandoff and ClearBackdrop use it. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- "COM interfaces might be trimmed": not ours, partial mode leaves this assembly whole. -->
    <NoWarn>$(NoWarn);IL2050</NoWarn>
  </PropertyGroup>

  <Import Project="..\Zinc.Native.targets" />

  <ItemGroup>
    <!-- Loose copy for AppWindow.SetIcon (title bar, taskbar, Alt+Tab). -->
    <Content Include="Assets\Zinc.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Zinc's own schemes (Lit Cell, Lit Cell Light), apart from the collection below, whose refresh replaces its folder. -->
    <Content Include="..\..\assets\zinc-themes\*" Exclude="..\..\assets\zinc-themes\README.md" Link="Themes\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Bundled color schemes (theme = "Name"), with their license. assets/themes/README.md says where they come from. -->
    <Content Include="..\..\assets\themes\*" Exclude="..\..\assets\themes\README.md" Link="Themes\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Zinc's own custom shaders, by name in [shaders] files (ShaderPaths): written for Zinc, so they ship. -->
    <Content Include="..\..\assets\shaders\*.glsl" Link="Shaders\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The default font, Cascadia Mono NF (Microsoft's Nerd Font build), used without installing it. -->
    <Content Include="..\..\assets\fonts\*" Link="Fonts\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Brand artwork shown in the app: About's lockup, the welcome page's app tile (docs/brand.md). -->
    <Content Include="..\..\assets\brand\lockups\quadrant-zinc-dark.svg;..\..\assets\brand\lockups\quadrant-zinc-light.svg;..\..\assets\brand\mark\quadrant-app-tile.svg"
             Link="Brand\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- License texts of the open-source software Zinc ships (Settings > About; OpenSourceNotices.cs). -->
    <Content Include="..\..\assets\licenses\*" Link="Licenses\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Shell integration scripts, loaded into the shells Zinc starts (ShellIntegration.cs). -->
    <Content Include="..\..\assets\shell-integration\**\*" Link="ShellIntegration\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zinc.Core\Zinc.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows App SDK 2.5.1 component packages (the versions its metapackage pins).
         The metapackage also drags in AI/ML/Search/Widgets (onnxruntime, DirectML, ...),
         roughly doubling the install size for nothing a terminal uses. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <!-- Executable icon extraction for profile icons (ProfileIcons.cs). -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    <!-- Installer and updates (Program.cs, Updater.cs). Keep its version equal to vpk's in dotnet-tools.json. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- Custom shaders (ShaderPass.cs): Direct3D 11 on Win2D's device, and D3DCompile. Trimmed: a few hundred KB. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
  </ItemGroup>

  <!-- Where release builds look for updates (scripts/release.ps1 -UpdateUrl); dev builds have none (Updater.Source). -->
  <ItemGroup Condition="'$(ZincUpdateUrl)' != ''">
    <AssemblyMetadata Include="ZincUpdateUrl" Value="$(ZincUpdateUrl)" />
  </ItemGroup>

  <!-- zn, the command-line tool, in bin\ next to zinc.exe (a folder of its own, so putting it on PATH exposes nothing
       else; terminals get it appended to theirs: CliServer). Builds copy its framework-dependent build (dev machines have .NET);
       publishes (install.ps1, release.ps1) publish it ahead of time: one self-contained zn.exe. -->
  <PropertyGroup>
    <ZnProject>$(MSBuildThisFileDirectory)..\Zinc.Cli\Zinc.Cli.csproj</ZnProject>
  </PropertyGroup>

  <Target Name="CopyZn" AfterTargets="Build">
    <MSBuild Projects="$(ZnProject)" Targets="Build" Properties="Configuration=$(Configuration);Platform=x64">
      <Output TaskParameter="TargetOutputs" ItemName="_ZnBuilt" />
    </MSBuild>
    <PropertyGroup>
      <_ZnDir>@(_ZnBuilt->'%(RootDir)%(Directory)')</_ZnDir>
    </PropertyGroup>
    <ItemGroup>
      <_ZnFiles Include="$(_ZnDir)zn.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ZnFiles)" DestinationFolder="$(OutDir)bin" SkipUnchangedFiles="true" />
  </Target>

  <!-- Left out of publishes: the .NET debugger's support files (only a debugger attaching uses them) and WebView2,
       which WinUI brings along and nothing in Zinc shows (yet: tabs that aren't terminals may want it back). -->
  <Target Name="DropUnusedFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^(mscordaccore.*|mscordbi|Microsoft\.DiaSymReader\.Native\..*|Microsoft\.Web\.WebView2\..*|WebView2Loader)$'))" />
    </ItemGroup>
  </Target>

  <!-- Its own dotnet publish, with vswhere.exe's folder on PATH: Native AOT's link step finds MSVC through it. -->
  <Target Name="PublishZn" AfterTargets="Publish">
    <PropertyGroup>
      <_ZnPublishDir>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))bin</_ZnPublishDir>
    </PropertyGroup>
    <Exec Command="dotnet publish &quot;$(ZnProject)&quot; -c $(Configuration) -r win-x64 -p:Platform=x64 -o &quot;$(_ZnPublishDir)&quot; -nologo"
          EnvironmentVariables="PATH=$([MSBuild]::Escape('$(PATH);$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer'))" />
    <Delete Files="$(_ZnPublishDir)\zn.pdb" />
    <Error Condition="!Exists('$(_ZnPublishDir)\zn.exe')" Text="zn.exe wasn't published into $(_ZnPublishDir)." />
  </Target>
</Project>
