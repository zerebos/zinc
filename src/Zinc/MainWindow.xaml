<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Zinc.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Zinc">
    <Grid x:Name="Root" AllowDrop="True" DragOver="OnRootDragOver" DragLeave="OnRootDragLeave" Drop="OnRootDrop">
        <!-- The tab strip doubles as the title bar (ExtendsContentIntoTitleBar).
             TabView's style defaults to VerticalAlignment=Top: without Stretch the control
             is only as tall as its strip and tab content gets 0 px. -->
        <TabView
            x:Name="Tabs"
            VerticalAlignment="Stretch"
            TabWidthMode="Equal"
            CanReorderTabs="True"
            CanDragTabs="True"
            AllowDropTabs="True"
            TabDragStarting="OnTabDragStarting"
            TabDragCompleted="OnTabDragCompleted"
            TabDroppedOutside="OnTabDroppedOutside"
            TabStripDragOver="OnTabStripDragOver"
            TabStripDrop="OnTabStripDrop"
            AddTabButtonClick="OnAddTabButtonClick"
            TabCloseRequested="OnTabCloseRequested"
            SelectionChanged="OnSelectionChanged">
            <TabView.TabStripFooter>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Sized and placed like TabView's own "+" button (24 px tall,
                         3 px above the strip's bottom) so the two line up. -->
                    <Button
                        x:Name="NewTabMenuButton"
                        Height="24"
                        Margin="0,0,0,3"
                        VerticalAlignment="Bottom"
                        Padding="8,0"
                        Background="Transparent"
                        BorderThickness="0"
                        AutomationProperties.Name="Open a profile">
                        <FontIcon FontSize="12" Glyph="&#xE70D;" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="NewTabMenu" Placement="BottomEdgeAlignedLeft" />
                        </Button.Flyout>
                    </Button>
                    <!-- Empty strip area: drags the window. -->
                    <Grid x:Name="DragRegion" Grid.Column="1" Background="Transparent" />
                </Grid>
            </TabView.TabStripFooter>
        </TabView>

        <!-- Where a dragged tab would land when dropped on a pane's edge (MainWindow.Drag.cs). -->
        <Border
            x:Name="DropPreview"
            Canvas.ZIndex="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{ThemeResource SystemControlHighlightAccentBrush}"
            Opacity="0.3"
            IsHitTestVisible="False"
            Visibility="Collapsed" />

        <!-- Notices, stacked at the bottom right; each on a solid backing (MainWindow.Errors.cs: SolidNoticeBacks). -->
        <StackPanel
            x:Name="Notices"
            Canvas.ZIndex="10"
            MaxWidth="520"
            Margin="12"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Spacing="8">
            <!-- Problems in config.toml, after loading or a reload (MainWindow.Config.cs). -->
            <InfoBar x:Name="ConfigNotice" IsOpen="False" Severity="Warning">
                <InfoBar.ActionButton>
                    <Button x:Name="OpenConfigButton" Content="Open config" />
                </InfoBar.ActionButton>
            </InfoBar>
            <!-- Custom shaders that couldn't be used (MainWindow.Shaders.cs); the terminals draw without them. -->
            <InfoBar x:Name="ShaderNotice" IsOpen="False" Severity="Warning" Title="A custom shader isn't running">
                <InfoBar.ActionButton>
                    <Button x:Name="OpenShaderConfigButton" Content="Open config" />
                </InfoBar.ActionButton>
            </InfoBar>
            <!-- A downloaded update, ready to install (Updater, MainWindow.Updates.cs). -->
            <InfoBar x:Name="UpdateNotice" IsOpen="False" Severity="Informational" IsClosable="False">
                <InfoBar.Content>
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RestartForUpdateButton" Content="Restart Zinc" Style="{ThemeResource AccentButtonStyle}" />
                        <Button x:Name="UpdateLaterButton" Content="Install when I quit" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>
            <!-- Something failed and was survived (App.UnhandledException); details in crash.log. -->
            <InfoBar x:Name="ErrorNotice" IsOpen="False" Severity="Error" Title="Zinc hit an error and kept running">
                <InfoBar.ActionButton>
                    <Button x:Name="OpenCrashLogButton" Content="Open crash log" />
                </InfoBar.ActionButton>
            </InfoBar>
            <!-- Shown when the quick terminal's global hotkey is held by another app. -->
            <InfoBar
                x:Name="HotkeyNotice"
                IsOpen="False"
                Severity="Warning"
                Title="Quick terminal hotkey unavailable" />
        </StackPanel>

        <!-- Command palette (Ctrl+Shift+P). The transparent layer catches clicks outside
             the panel to close it. -->
        <Grid x:Name="PaletteLayer" Canvas.ZIndex="10" Background="Transparent" Visibility="Collapsed">
            <Border
                x:Name="PalettePanel"
                Width="640"
                MaxHeight="460"
                Margin="0,52,0,0"
                Padding="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox
                        x:Name="PaletteQuery"
                        AutomationProperties.Name="Command palette search"
                        PlaceholderText="Type a command, or @ to find a tab" />
                    <ListView
                        x:Name="PaletteList"
                        Grid.Row="1"
                        AutomationProperties.Name="Commands"
                        IsItemClickEnabled="True"
                        SelectionMode="Single" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
