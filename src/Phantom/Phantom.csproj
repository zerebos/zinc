<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Phantom</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <!-- Also covers solution builds, which may pass Platform=AnyCPU globally (a global
         property the Platform default above can't override); WinAppSDK then keys off the RID. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Needed so `dotnet publish` includes the .pri and compiled XAML (.xbf) of an
         unpackaged app; without them WinUI crashes at startup (0xC000027B). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embedded in the exe: Explorer, Start Menu shortcut, Raycast. Generated by scripts/gen-icon.py. -->
    <ApplicationIcon>Assets\Phantom.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Import Project="..\Phantom.Native.targets" />

  <ItemGroup>
    <!-- Loose copy for AppWindow.SetIcon (title bar, taskbar, Alt+Tab). -->
    <Content Include="Assets\Phantom.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Phantom.Core\Phantom.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows App SDK 2.5.1 component packages (the versions its metapackage pins).
         The metapackage also drags in AI/ML/Search/Widgets (onnxruntime, DirectML, ...),
         roughly doubling the install size for nothing a terminal uses. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>
</Project>
