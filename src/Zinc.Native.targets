<!--
  Native runtime dependencies for anything that *runs* Zinc.Core (the app and the tests):
  libghostty-vt and Windows Terminal's out-of-box ConPTY. Import after Platform is set.
-->
<Project>
  <PropertyGroup>
    <GhosttyArch Condition="'$(Platform)' == 'ARM64'">arm64</GhosttyArch>
    <GhosttyArch Condition="'$(GhosttyArch)' == ''">x64</GhosttyArch>
    <GhosttyNativeDir>$(MSBuildThisFileDirectory)..\native\$(GhosttyArch)\</GhosttyNativeDir>

    <!-- The ConPTY package picks which OpenConsole hosts to ship from $(Platform) in its
         .props, which run before the project sets Platform; choose them explicitly instead.
         An x64 app may also run emulated on ARM64, so it ships both hosts. -->
    <ConptyRequiresx64Host Condition="'$(GhosttyArch)' == 'x64'">true</ConptyRequiresx64Host>
    <ConptyRequiresARM64Host>true</ConptyRequiresARM64Host>
  </PropertyGroup>

  <!-- libghostty-vt and Ghostty's sprite rasterizer (zinc-sprite: box drawing, blocks,
       Legacy Computing, Powerline) are built by scripts/build/libghostty.ps1 into native/<arch>/. -->
  <ItemGroup>
    <None Include="$(GhosttyNativeDir)ghostty-vt.dll" Link="ghostty-vt.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(GhosttyNativeDir)ghostty-vt.pdb" Link="ghostty-vt.pdb" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Visible="false" Condition="Exists('$(GhosttyNativeDir)ghostty-vt.pdb')" />
    <None Include="$(GhosttyNativeDir)zinc-sprite.dll" Link="zinc-sprite.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(GhosttyNativeDir)zinc-sprite.pdb" Link="zinc-sprite.pdb" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Visible="false" Condition="Exists('$(GhosttyNativeDir)zinc-sprite.pdb')" />
    <!-- Custom shaders' GLSL -> HLSL translator (scripts/build/shader.ps1). It uses the static C runtime, so it
         imports only KERNEL32. Loaded only when a shader is configured. -->
    <None Include="$(GhosttyNativeDir)zinc-shader.dll" Link="zinc-shader.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(GhosttyNativeDir)zinc-shader.pdb" Link="zinc-shader.pdb" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Visible="false" Condition="Exists('$(GhosttyNativeDir)zinc-shader.pdb')" />
    <!-- Both import the Visual C++ runtime, which isn't part of Windows (a fresh PC lacks it: "Unable to load
         DLL 'ghostty-vt'"); it ships beside them, app-local (scripts/build/copy-vcruntime.ps1). -->
    <None Include="$(GhosttyNativeDir)vcruntime140.dll" Link="vcruntime140.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="CheckGhostty" BeforeTargets="Build">
    <Error Condition="!Exists('$(GhosttyNativeDir)ghostty-vt.dll')"
           Text="ghostty-vt.dll not found in $(GhosttyNativeDir). Run: pwsh scripts/build/libghostty.ps1 -Arch $(GhosttyArch)" />
    <Error Condition="!Exists('$(GhosttyNativeDir)zinc-sprite.dll')"
           Text="zinc-sprite.dll not found in $(GhosttyNativeDir). Run: pwsh scripts/build/sprites.ps1 -Arch $(GhosttyArch)" />
    <Error Condition="!Exists('$(GhosttyNativeDir)zinc-shader.dll')"
           Text="zinc-shader.dll not found in $(GhosttyNativeDir). Run: pwsh scripts/build/shader.ps1 -Arch $(GhosttyArch)" />
    <Error Condition="!Exists('$(GhosttyNativeDir)vcruntime140.dll')"
           Text="vcruntime140.dll not found in $(GhosttyNativeDir). Run: pwsh scripts/build/copy-vcruntime.ps1 -Arch $(GhosttyArch)" />
  </Target>

  <ItemGroup>
    <!-- Windows Terminal's out-of-box ConPTY (conpty.dll + OpenConsole.exe): far higher
         throughput than the inbox conhost, and grapheme-aware width measurement.
         Referenced here, not in Zinc.Core, because its OpenConsole copy step lives in
         build/ (not buildTransitive/) and so only runs for direct references. -->
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.24.260710001" />
  </ItemGroup>
</Project>
