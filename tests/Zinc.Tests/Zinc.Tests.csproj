<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\src\Zinc.Platform.props" />
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <!-- Also covers solution builds, which may pass Platform=AnyCPU globally (a global
         property the Platform default above can't override); WinAppSDK then keys off the RID. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Off Windows the tests build for plain .NET, like Zinc.Core, and run whatever doesn't need Windows. -->
  <PropertyGroup Condition="'$(ZincWindows)' != 'true'">
    <TargetFramework>net10.0</TargetFramework>
    <TargetPlatformMinVersion />
    <RuntimeIdentifier />
  </PropertyGroup>

  <Import Project="..\..\src\Zinc.Native.targets" Condition="'$(ZincWindows)' == 'true'" />

  <ItemGroup Condition="'$(ZincWindows)' != 'true'">
    <None Include="..\..\native\macos-arm64\*.dylib" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- These build their PNGs with Windows' imaging API. -->
    <Compile Remove="KittyGraphicsTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zinc.Core\Zinc.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
