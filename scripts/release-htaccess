# Zinc's release folder (scripts/release.ps1 -Publish uploads this as .htaccess once).
# No folder listing. The files that keep their name from release to release must never be cached, by the
# server or by a CDN in front of it (Cloudflare caches .exe and .zip by default): a cached release list keeps
# installed copies on an old version, a cached Setup.exe hands out one. Packages carry their version in the
# name and never change, so they may be cached.
Options -Indexes
<IfModule mod_headers.c>
    <FilesMatch "^(releases\..+\.json|assets\..+\.json|RELEASES|.+-Setup\.exe|.+-Portable\.zip)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# Packages, the installer and the zip are zips already: sent as they are, with their size. Compressed on the fly
# they lost Content-Length (and ranges), so Velopack couldn't show progress: a tester saw 0% for a whole download.
AddType application/octet-stream .nupkg
<IfModule mod_setenvif.c>
    SetEnvIfNoCase Request_URI "\.(nupkg|exe|zip)$" no-gzip dont-vary
</IfModule>
