+test "Screen: resize reflow marks a wrapped prompt line like printing does" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    // The same prompt printed at 5 columns, so it wraps as it prints.
+    var printed = try init(io, alloc, .{ .cols = 5, .rows = 4, .max_scrollback_bytes = 0 });
+    defer printed.deinit();
+    printed.cursorSetSemanticContent(.{ .prompt = .initial });
+    try printed.testWriteString("ABCDEFGHIJ");
+
+    // Printed at 10 columns, then narrowed to 5, so it wraps on reflow.
+    var reflowed = try init(io, alloc, .{ .cols = 10, .rows = 4, .max_scrollback_bytes = 0 });
+    defer reflowed.deinit();
+    reflowed.cursorSetSemanticContent(.{ .prompt = .initial });
+    try reflowed.testWriteString("ABCDEFGHIJ");
+    try reflowed.resize(.{ .cols = 5, .rows = 4 });
+
+    for ([_]*Screen{ &printed, &reflowed }) |s| {
+        const contents = try s.dumpStringAlloc(alloc, .{ .screen = .{} });
+        defer alloc.free(contents);
+        try testing.expectEqualStrings("ABCDE\nFGHIJ", contents);
+
+        const first = s.pages.pin(.{ .screen = .{ .y = 0 } }).?;
+        const second = s.pages.pin(.{ .screen = .{ .y = 1 } }).?;
+        try testing.expectEqual(.prompt, first.rowAndCell().row.semantic_prompt);
+        try testing.expectEqual(.prompt_continuation, second.rowAndCell().row.semantic_prompt);
+
+        // One prompt, so one prompt start, found from its last row.
+        var it = second.promptIterator(.left_up, null);
+        try testing.expectEqual(@as(?size.CellCountInt, 0), if (it.next()) |p| p.y else null);
+        try testing.expect(it.next() == null);
+    }
+}
+
+test "Screen: resize reflow keeps a rejoined prompt line a prompt" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    var s = try init(io, alloc, .{ .cols = 5, .rows = 4, .max_scrollback_bytes = 0 });
+    defer s.deinit();
+    s.cursorSetSemanticContent(.{ .prompt = .initial });
+    try s.testWriteString("ABCDEFGHIJ");
+
+    // Widening joins the two rows back into one, which starts the prompt.
+    try s.resize(.{ .cols = 10, .rows = 4 });
+    {
+        const contents = try s.dumpStringAlloc(alloc, .{ .screen = .{} });
+        defer alloc.free(contents);
+        try testing.expectEqualStrings("ABCDEFGHIJ", contents);
+    }
+    const first = s.pages.pin(.{ .screen = .{ .y = 0 } }).?;
+    try testing.expectEqual(.prompt, first.rowAndCell().row.semantic_prompt);
+}
+
+test "Screen: resize with prompt_redraw clears a prompt line that wraps" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    var s = try init(io, alloc, .{ .cols = 10, .rows = 5, .max_scrollback_bytes = 0 });
+    defer s.deinit();
+
+    // Output, then a two-line prompt whose first line fills the width (like a
+    // prompt with a frame or a right-aligned part), then the input.
+    try s.testWriteString("out\n");
+    s.cursorSetSemanticContent(.{ .prompt = .initial });
+    try s.testWriteString("PPPPPPPPPP\n> ");
+    s.cursorSetSemanticContent(.{ .input = .clear_explicit });
+    try s.testWriteString("ls");
+
+    // Narrowing wraps the first prompt line. The whole prompt is cleared for the
+    // shell to redraw, not only the rows from its wrapped piece down.
+    try s.resize(.{ .cols = 5, .rows = 5, .prompt_redraw = .true });
+    const contents = try s.dumpStringAlloc(alloc, .{ .screen = .{} });
+    defer alloc.free(contents);
+    try testing.expectEqualStrings("out", contents);
+}
