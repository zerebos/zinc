Reflow marks the rows a prompt line wraps onto as prompt continuations, and a
rejoined row keeps the flag of the row it continues.

libghostty documents Row.semantic_prompt = .prompt as "not a continuation and
the beginning of a prompt" (since the January 2026 semantic prompt rework), and
the prompt iterator, the clear-on-resize (prompt_redraw), jump-to-prompt and
click-to-move rely on it. Reflow still copied a row's flag onto every wrapped
piece, which made each piece look like a prompt start: the clear-on-resize then
left the upper pieces of a full-width prompt line behind (powerlevel10k's
frame piled up on every narrowing resize). Widening copied a continuation's
flag over the row it joined, losing the prompt's start.

Not upstream yet (pinned 6301810a4; still present on main 73e4ff10f,
2026-10-17). Drop this patch once a commit bump includes a fix. Applied by
scripts/build/libghostty.ps1 after checkout. Includes tests; run them with
`zig build test-lib-vt -Dtest-filter=prompt` in external/ghostty.

diff --git a/src/terminal/PageList.zig b/src/terminal/PageList.zig
index d915bcf6d8..371982a0ad 100644
--- a/src/terminal/PageList.zig
+++ b/src/terminal/PageList.zig
@@ -1746,7 +1746,10 @@ const ReflowCursor = struct {
             self.new_rows -= 1;
         }
 
-        self.copyRowMetadata(src_row);
+        // A wrap continuation joins the row it continues, which keeps its own
+        // metadata: a prompt's first row must stay a prompt, not become the
+        // continuation's prompt_continuation.
+        if (!src_row.wrap_continuation) self.copyRowMetadata(src_row);
 
         var x: usize = 0;
         while (x < cols_len) {
@@ -1755,6 +1758,13 @@ const ReflowCursor = struct {
                 try self.cursorScrollOrNewPage(list, cap);
                 self.copyRowMetadata(src_row);
                 self.page_row.wrap_continuation = true;
+
+                // A prompt row that now wraps continues onto this row, as when
+                // it wraps while printing (Terminal.printWrap), so the prompt
+                // iterator still finds the prompt's first row.
+                if (self.page_row.semantic_prompt == .prompt) {
+                    self.page_row.semantic_prompt = .prompt_continuation;
+                }
             }
 
             // Fast path: bulk-copy a run of simple cells directly
@@ -17403,9 +17413,10 @@ test "PageList resize reflow less cols no reflow preserves semantic prompt" {
             try testing.expect(rac.row.semantic_prompt == .prompt);
         }
         {
+            // The wrapped part continues the prompt that starts on the row above.
             const p = s.pin(.{ .active = .{ .y = 2 } }).?;
             const rac = p.rowAndCell();
-            try testing.expect(rac.row.semantic_prompt == .prompt);
+            try testing.expect(rac.row.semantic_prompt == .prompt_continuation);
         }
     }
 }
